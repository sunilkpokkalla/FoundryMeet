rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      // Avatars are loaded via URLSession/AsyncImage (no Firebase Auth header).
      // Public read is required so profile photos render in the app header and feeds.
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Separate from create/update because delete has no request.resource.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
