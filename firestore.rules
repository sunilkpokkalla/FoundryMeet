rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isReviewer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isReviewer == true;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;

      match /interactions/{interactionId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /matches/{matchId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.participantIds
            || resource.data.userId == request.auth.uid
            || resource.data.candidateId == request.auth.uid);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.participantIds
            || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    match /mailOutbox/{mailId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /pushOutbox/{pushId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /credentialReviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isReviewer() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isReviewer();
      allow delete: if false;
    }
  }
}
