rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isReviewer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isReviewer == true;
    }

    match /users/{userId} {
      // Reviewer status is console/admin only — clients cannot grant it to themselves.
      function reviewerUnchanged() {
        return request.resource.data.get('isReviewer', false)
          == resource.data.get('isReviewer', false);
      }

      allow read: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.get('isReviewer', false) == false;
      allow update: if isSelf(userId) && reviewerUnchanged();
      allow delete: if false;

      match /interactions/{interactionId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /matches/{matchId} {
      // Only the recipient of an open request may accept or decline it.
      function answeringAsRecipient() {
        return request.auth.uid == resource.data.recipientId
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.recipientId == resource.data.recipientId;
      }

      // Only the sender of an open request may pull it back.
      function withdrawingAsRequester() {
        return request.auth.uid == resource.data.requesterId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.recipientId == resource.data.recipientId;
      }

      // A closed request can be opened again, in either direction.
      function reopeningClosedRequest() {
        return resource.data.status in ['declined', 'withdrawn']
          && request.resource.data.status == 'pending'
          && request.auth.uid == request.resource.data.requesterId
          && request.auth.uid in resource.data.participantIds;
      }

      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      // Only the requester opens a request, and it always starts pending.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.requesterId
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.resource.data.participantIds == resource.data.participantIds
        && (answeringAsRecipient() || withdrawingAsRequester() || reopeningClosedRequest());
      allow delete: if false;
    }

    match /chats/{chatId} {
      // participantIds is always sorted, so it rebuilds the match document id.
      function matchIsAccepted() {
        let pair = request.resource.data.participantIds;
        return get(/databases/$(database)/documents/matches/$(pair[0] + '_' + pair[1])).data.status == 'accepted';
      }

      // Nobody confirms a time they proposed themselves. Edits that leave the
      // status alone, such as saving notes, are always fine.
      function notSelfConfirming() {
        return request.resource.data.status != 'confirmed'
          || resource.data.status == request.resource.data.status
          || request.auth.uid != resource.data.get('proposedById', '');
      }

      allow read: if signedIn()
        && (request.auth.uid in resource.data.participantIds
            || resource.data.userId == request.auth.uid
            || resource.data.candidateId == request.auth.uid);
      // A time can only be proposed once both people agreed to meet.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.proposedById == request.auth.uid
        && matchIsAccepted();
      // Either participant can decline, move, or cancel the chat, but the pair
      // it belongs to is fixed at creation.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && notSelfConfirming();
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    match /pushOutbox/{pushId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /credentialReviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isReviewer() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isReviewer();
      allow delete: if false;
    }
  }
}
